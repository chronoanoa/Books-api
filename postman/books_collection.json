{
  "info": {
    "_postman_id": "00bb1a45-ed6d-484a-8a51-7c9a0748dc2c",
    "name": "Books API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    },
    {
      "key": "book_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Get all books",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "books"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('count matches books length', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.count).to.eql(body.books.length);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Get book by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books/{{book_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "books",
            "{{book_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('id matches', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.id).to.eql(Number(pm.environment.get('book_id')));",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Search books",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books/search?title=мастер",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "books",
            "search"
          ],
          "query": [
            {
              "key": "title",
              "value": "мастер"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('results is an array', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.books).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Create book",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Война и мир\",\n  \"author\": \"Лев Толстой\",\n  \"year\": 1869,\n  \"is_available\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/books",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "books"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('save book id', () => {",
              "  const body = pm.response.json();",
              "  pm.environment.set('book_id', body.book.id);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Update book (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Анна Каренина\",\n  \"author\": \"Лев Толстой\",\n  \"year\": 1877,\n  \"is_available\": false\n}"
        },
        "url": {
          "raw": "{{base_url}}/books/{{book_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "books",
            "{{book_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Patch book",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_available\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/books/{{book_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "books",
            "{{book_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('field updated', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.book.is_available).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Delete book",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books/{{book_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "books",
            "{{book_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
